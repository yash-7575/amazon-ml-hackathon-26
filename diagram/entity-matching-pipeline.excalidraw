    {
      "type": "text",
      "id": "s1_norm_b",
      "x": 178,
      "y": 624,
      "width": 630,
      "height": 120,
      "text": "• Name normalization      (suffixes: Inc / Ltd / Pvt / SARL)\n• Address normalization   (Rd→Road, St→Street, landmarks)\n• Missing values          (~3.3% addresses empty → name-only)\n• City / Country / Postcode normalization\n• Unicode by CATEGORY, not \\w  (protects Devanagari)",
      "originalText": "• Name normalization      (suffixes: Inc / Ltd / Pvt / SARL)\n• Address normalization   (Rd→Road, St→Street, landmarks)\n• Missing values          (~3.3% addresses empty → name-only)\n• City / Country / Postcode normalization\n• Unicode by CATEGORY, not \\w  (protects Devanagari)",
      "fontSize": 16,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
