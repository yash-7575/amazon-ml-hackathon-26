      "height": 30,
      "text": "CANDIDATE GENERATION / BLOCKING",
      "originalText": "CANDIDATE GENERATION / BLOCKING",
      "fontSize": 22,
      "fontFamily": 3,
      "textAlign": "center",
      "verticalAlign": "top",
